u7b97\\uff0c\\u4f7f\\u7528 Log($volume / Sum($volume, 20) + 1)\\n   - \\u907f\\u514d\\u5728\\u5206\\u6bcd\\u4e2d\\u4f7f\\u7528\\u53ef\\u80fd\\u4e3a0\\u7684\\u8868\\u8fbe\\u5f0f\\n8. \\u8bbe\\u8ba1Alpha\\u8868\\u8fbe\\u5f0f\\u65f6\\uff0c\\u5c3d\\u91cf\\u907f\\u514d\\u51fa\\u73b0\\u5982\\u4e0b\\u5b50\\u8868\\u8fbe\\u5f0f\\uff1a\\n   \\u65e0\\n\\n\\u6ce8\\u610f\\uff1a\\u8f93\\u51fa\\u683c\\u5f0f\\u4e3aJSON\\uff0c\\u5305\\u542b\\u7b26\\u53f7\\u516c\\u5f0f\\u548c\\u53c2\\u6570\\u5efa\\u8bae\\uff1a\\n{\\n  \\\"formula\\\": \\\"\\u7b26\\u53f7\\u5316\\u7684\\u516c\\u5f0f\\u8868\\u8fbe\\u5f0f\\\",\\n  \\\"parameters\\\": {\\n    \\\"\\u53c2\\u6570\\u540d\\\": {\\\"description\\\": \\\"\\u53c2\\u6570\\u542b\\u4e49\\\", \\\"range\\\": [\\u6700\\u5c0f\\u503c, \\u6700\\u5927\\u503c]},\\n    ...\\n  },\\n  \\\"candidates\\\": [\\n    {\\\"\\u53c2\\u65701\\\": \\u503c1, \\\"\\u53c2\\u65702\\\": \\u503c2, ...},  // \\u7b2c1\\u7ec4\\u5019\\u9009\\u53c2\\u6570\\n    {\\\"\\u53c2\\u65701\\\": \\u503c1, \\\"\\u53c2\\u65702\\\": \\u503c2, ...},  // \\u7b2c2\\u7ec4\\u5019\\u9009\\u53c2\\u6570\\n    {\\\"\\u53c2\\u65701\\\": \\u503c1, \\\"\\u53c2\\u65702\\\": \\u503c2, ...}   // \\u7b2c3\\u7ec4\\u5019\\u9009\\u53c2\\u6570\\n  ]\\n}\\n\\n\\u793a\\u4f8b\\u8f93\\u51fa\\uff1a\\n{\\n  \\\"formula\\\": \\\"Rank((($close - Ref($close, w1)) / Ref($close, w1)) / Std($close, w2), w3)\\\",\\n  \\\"parameters\\\": {\\n    \\\"w1\\\": {\\\"description\\\": \\\"\\u4ef7\\u683c\\u53d8\\u5316\\u56de\\u770b\\u7a97\\u53e3\\\", \\\"range\\\": [5, 30]},\\n    \\\"w2\\\": {\\\"description\\\": \\\"\\u6ce2\\u52a8\\u7387\\u8ba1\\u7b97\\u7a97\\u53e3\\\", \\\"range\\\": [10, 60]},\\n    \\\"w3\\\": {\\\"description\\\": \\\"\\u6392\\u540d\\u7a97\\u53e3\\\", \\\"range\\\": [5, 20]}\\n  },\\n  \\\"candidates\\\": [\\n    {\\\"w1\\\": 20, \\\"w2\\\": 30, \\\"w3\\\": 10},\\n    {\\\"w1\\\": 10, \\\"w2\\\": 20, \\\"w3\\\": 5},\\n    {\\\"w1\\\": 30, \\\"w2\\\": 45, \\\"w3\\\": 15}\\n  ]\\n}\"}]",
        "output": "{\n  \"formula\": \"Mean((($close - Ref($close, w1)) / Ref($close, w1)), w2)\",\n  \"parameters\": {\n    \"w1\": {\n      \"description\": \"过去收益率计算的回看窗口\",\n      \"range\": [1, 30]\n    },\n    \"w2\": {\n      \"description\": \"收益率平滑窗口\",\n      \"range\": [2, 60]\n    }\n  },\n  \"candidates\": [\n    {\n      \"w1\": 1,\n      \"w2\": 5\n    },\n    {\n      \"w1\": 5,\n      \"w2\": 10\n    },\n    {\n      \"w1\": 10,\n      \"w2\": 20\n    }\n  ]\n}",
